DATABASE_URL="file:./data/budget.db"
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:1313"

# Required by POST /api/agent (the chat entry point). The route fails CLOSED
# with 503 when this is unset, so an unconfigured deploy cannot be probed.
AGENT_API_TOKEN="change-me"

# Where the Needle checkpoints live on the host. Mounted read-only into the
# sidecar, so a new finetune is `docker compose restart needle`, not a rebuild.
NEEDLE_MODELS_DIR="/path/to/cactus-needle/checkpoints"
