          "value": "\"budgets\".\"period\" IN ('weekly', 'monthly', 'yearly')"
        },
        "budgets_window_valid": {
          "name": "budgets_window_valid",
          "value": "\"budgets\".\"effective_to\" IS NULL OR \"budgets\".\"effective_to\" >= \"budgets\".\"effective_from\""
        },
        "budgets_goal_valid": {
          "name": "budgets_goal_valid",
          "value": "(\n        \"budgets\".\"goal_name\" IS NULL AND \"budgets\".\"goal_amount_cents\" IS NULL\n      ) OR (\n        \"budgets\".\"goal_name\" IS NOT NULL\n        AND \"budgets\".\"goal_amount_cents\" IS NOT NULL\n        AND length(trim(\"budgets\".\"goal_name\")) > 0\n        AND typeof(\"budgets\".\"goal_amount_cents\") = 'integer'\n        AND \"budgets\".\"goal_amount_cents\" > 0\n        AND \"budgets\".\"period\" = 'monthly'\n        AND \"budgets\".\"rollover\" = 1\n      )"
        }
      }
    },
