{
  "name": "localfi",
  "version": "0.1.0",
  "description": "A local-first personal finance dashboard.",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "keywords": ["personal-finance", "budget", "local-first", "sqlite"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --turbopack -p 1313",
    "build": "node node_modules/next/dist/bin/next build --webpack",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "db:generate": "drizzle-kit generate",
    "db:setup": "node --import tsx scripts/refuse-headless-vault-setup.ts",
    "db:init": "node --import tsx scripts/refuse-headless-vault-setup.ts",
    "db:seed": "node --import tsx lib/db/seed.ts",
    "db:sample": "node --import tsx lib/db/sample-data.ts",
    "db:demo": "LOCALFI_VAULT_TEST_MODE=plaintext LOCALFI_DEMO_GENERATOR=1 node --import tsx scripts/create-demo-db.ts",
    "showcase:capture": "LOCALFI_VAULT_TEST_MODE=plaintext LOCALFI_DEMO_GENERATOR=1 node --import tsx scripts/capture-demo-screenshots.ts",
    "db:upgrade": "node --import tsx scripts/db-upgrade.ts",
    "db:restore": "node --import tsx scripts/db-restore.ts",
    "ledger:verify": "node --import tsx scripts/ledger-verify.ts",
    "ledger:rebuild": "node --import tsx scripts/ledger-rebuild.ts --projection-only",
    "agent:sidecar": "${NEEDLE_HOME:-$HOME/.local/share/cactus-needle}/.venv/bin/python agent/needle_sidecar.py",
    "agent": "node node_modules/tsx/dist/cli.mjs scripts/agent-cli.ts",
    "agent:once": "node node_modules/tsx/dist/cli.mjs scripts/agent-cli.ts --once",
    "agent:api": "node node_modules/next/dist/bin/next start -p ${PORT:-1313}",
    "test": "LOCALFI_VAULT_TEST_MODE=plaintext node node_modules/vitest/vitest.mjs run",
    "test:watch": "LOCALFI_VAULT_TEST_MODE=plaintext node node_modules/vitest/vitest.mjs",
    "test:tz": "LOCALFI_VAULT_TEST_MODE=plaintext node -e \"const{execFileSync}=require('child_process');for(const tz of ['Pacific/Kiritimati','Pacific/Niue']){console.log('\\n=== vitest run with TZ='+tz+' ===');execFileSync(process.execPath,['node_modules/vitest/vitest.mjs','run'],{stdio:'inherit',env:{...process.env,TZ:tz}})}\"",
    "typegen": "node node_modules/next/dist/bin/next typegen --webpack",
    "typecheck": "bun run typegen && node node_modules/typescript/bin/tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "validate:agent": "LOCALFI_VAULT_TEST_MODE=plaintext node --import tsx scripts/validate-agent-work.ts",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-virtual": "^3.13.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "country-flag-icons": "^1.6.15",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "libsodium-wrappers-sumo": "^0.8.4",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^5.19.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.4",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.4",
    "read-excel-file": "^9.2.0",
    "recharts": "^2.15.4",
    "sql.js": "^1.13.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.10.5",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "@types/sql.js": "^1.4.9",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.3.0",
    "playwright-core": "^1.62.1",
    "postcss": "^8.4.49",
    "shadcn": "^3.7.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "lodash": "4.18.1",
    "protocol-buffers-schema": "3.6.1",
    "shell-quote": "1.10.0"
  }
}
