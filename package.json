{
  "name": "budget",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 1313",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:setup": "npm run db:init && npm run db:seed",
    "db:init": "tsx lib/db/init.ts",
    "db:seed": "tsx lib/db/seed.ts",
    "db:sample": "tsx lib/db/sample-data.ts",
    "agent:sidecar": "${NEEDLE_HOME:-$HOME/.local/share/cactus-needle}/.venv/bin/python agent/needle_sidecar.py",
    "agent": "node node_modules/tsx/dist/cli.mjs scripts/agent-cli.ts",
    "agent:once": "node node_modules/tsx/dist/cli.mjs scripts/agent-cli.ts --once",
    "agent:api": "node node_modules/next/dist/bin/next start -p ${PORT:-1313}",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tz": "node -e \"const{execFileSync}=require('child_process');for(const tz of ['Pacific/Kiritimati','Pacific/Niue']){console.log('\\n=== vitest run with TZ='+tz+' ===');execFileSync(process.execPath,['node_modules/vitest/vitest.mjs','run'],{stdio:'inherit',env:{...process.env,TZ:tz}})}\""
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "country-flag-icons": "^1.6.15",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.38.3",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.19.0",
    "next": "^15.1.6",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.71.1",
    "recharts": "^2.15.4",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^2.6.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "@types/sql.js": "^1.4.9",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.4.49",
    "shadcn": "^3.7.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
