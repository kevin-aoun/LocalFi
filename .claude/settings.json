{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(/data/**)",
      "Read(/backups/**)",
      "Read(/exports/**)",
      "Read(/.agent/**)",
      "Read(.env*)",
      "Read(credentials*.json)",
      "Read(**/*.db)",
      "Read(**/*.db-*)",
      "Read(**/*.sqlite)",
      "Read(**/*.sqlite3)",
      "Read(**/*.bak)",
      "Read(**/*.backup)",
      "Read(**/*.csv)",
      "Read(**/*.tsv)",
      "Read(**/*.xls)",
      "Read(**/*.xlsx)",
      "Read(**/*.ods)",
      "Read(**/*.ofx)",
      "Read(**/*.qfx)",
      "Read(**/*.qif)",
      "Edit(/data/**)",
      "Edit(/backups/**)",
      "Edit(/exports/**)",
      "Edit(/.agent/**)",
      "Edit(.env*)",
      "Edit(credentials*.json)",
      "Edit(.claude/**)",
      "Edit(.clinerules/**)",
      "Edit(.codex/**)",
      "Edit(.cursor/**)",
      "Edit(.gemini/**)",
      "Edit(.opencode/**)",
      "Edit(.pi/**)",
      "Edit(.windsurf/**)",
      "Edit(AGENTS.md)",
      "Edit(setup.sh)",
      "Edit(scripts/agent-private-path-guard.mjs)",
      "Edit(scripts/agent-private-path-guard.sh)",
      "Edit(**/*.db)",
      "Edit(**/*.db-*)",
      "Edit(**/*.sqlite)",
      "Edit(**/*.sqlite3)",
      "Edit(**/*.bak)",
      "Edit(**/*.backup)",
      "Edit(**/*.csv)",
      "Edit(**/*.tsv)",
      "Edit(**/*.xls)",
      "Edit(**/*.xlsx)",
      "Edit(**/*.ods)",
      "Edit(**/*.ofx)",
      "Edit(**/*.qfx)",
      "Edit(**/*.qif)",
      "Write(/data/**)",
      "Write(/backups/**)",
      "Write(/exports/**)",
      "Write(/.agent/**)",
      "Write(.env*)",
      "Write(credentials*.json)",
      "Write(.claude/**)",
      "Write(.clinerules/**)",
      "Write(.codex/**)",
      "Write(.cursor/**)",
      "Write(.gemini/**)",
      "Write(.opencode/**)",
      "Write(.pi/**)",
      "Write(.windsurf/**)",
      "Write(AGENTS.md)",
      "Write(setup.sh)",
      "Write(scripts/agent-private-path-guard.mjs)",
      "Write(scripts/agent-private-path-guard.sh)",
      "Write(**/*.db)",
      "Write(**/*.db-*)",
      "Write(**/*.sqlite)",
      "Write(**/*.sqlite3)",
      "Write(**/*.bak)",
      "Write(**/*.backup)",
      "Write(**/*.csv)",
      "Write(**/*.tsv)",
      "Write(**/*.xls)",
      "Write(**/*.xlsx)",
      "Write(**/*.ods)",
      "Write(**/*.ofx)",
      "Write(**/*.qfx)",
      "Write(**/*.qif)",
      "Bash(docker)",
      "Bash(docker *)",
      "Bash(/usr/bin/docker)",
      "Bash(/usr/bin/docker *)",
      "Bash(podman)",
      "Bash(podman *)",
      "Bash(sqlite3)",
      "Bash(sqlite3 *)",
      "Bash(setup.sh)",
      "Bash(./setup.sh)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Glob|Grep|Read|Write|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && sh scripts/agent-private-path-guard.sh claude"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "filesystem": {
      "denyRead": ["./data", "./backups", "./exports", "./.agent", "./.env", "./.env.local"],
      "denyWrite": ["./data", "./backups", "./exports", "./.agent", "./.env", "./.env.local"]
    }
  }
}
